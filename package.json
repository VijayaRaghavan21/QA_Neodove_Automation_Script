{
  "name": "neodove--playwright-bdd-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
  "test": "npx cucumber-js ./src/features/**/*.feature --require ./src/steps/**/*.js --require ./src/support/**/*.js --format json:./src/reports/allure-results/cucumber-report.json",
  "allure:generate": "npx allure generate ./src/reports/allure-results --clean -o ./src/reports/allure-report",
    "allure:open": "npx allure open ./src/reports/allure-report",
    "report": "npm run allures:generate && npm run allure:open",
    "debug": "node --inspect-brk ./node_modules/.bin/cucumber-js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.56.1",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.2",
    "playwright": "^1.56.1"
  }
}
