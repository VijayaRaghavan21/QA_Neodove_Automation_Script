{
  "default": {
    "require": ["./src/steps/*.js", "./src/support/hooks.js"],
    "paths": ["./src/features/*.feature"],
    "format": [
      "progress",
      "json:./src/reports/cucumber-report.json",
      "allure-cucumberjs/reporter"
    ],
    "formatOptions": {
      "resultsDir": "./allure-results"
    },
    "publishQuiet": true
  }
}
